# 测试环境 Docker 覆盖 — 指向测试容器名
POSTGRES_HOST=aperag-test-postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=aperag-test-redis
ES_HOST_NAME=aperag-test-es
NEO4J_HOST=aperag-test-neo4j
CELERY_BROKER_URL=redis://default:password@aperag-test-redis:6379/0
DATABASE_URL="postgresql://postgres:postgres@aperag-test-postgres:5432/postgres"
VECTOR_DB_CONTEXT={"url":"http://aperag-test-qdrant", "port":6333, "distance":"Cosine", "timeout": 1000}
ES_HOST=http://aperag-test-es:9200
MEMORY_REDIS_URL=redis://default:password@aperag-test-redis:6379

# Database Connection Pool
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# Path
TIKTOKEN_CACHE_DIR=/root/.cache/tiktoken

OBJECT_STORE_TYPE=local
OBJECT_STORE_LOCAL_ROOT_DIR=/shared/objects

# Jaeger — 复用生产 Jaeger，不做独立部署
JAEGER_ENABLED=True
JAEGER_ENDPOINT=http://aperag-jaeger:14268/api/traces
