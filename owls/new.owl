<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF 
    xmlns="http://www.cost-ontology.cn/ontology#" 
    xml:base="http://www.cost-ontology.cn/ontology"
    xmlns:owl="http://www.w3.org/2002/07/owl#" 
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" 
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.cost-ontology.cn/ontology">
        <rdfs:comment>公路工程造价知识图谱本体（修正版 v2.0）</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
        <rdfs:seeAlso>基于 JTG/T 3832-2018 公路工程预算定额及配套编制办法</rdfs:seeAlso>
    </owl:Ontology>

    <!-- ========================================================= -->
    <!--  顶层根类                                                  -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="CostEntity">
        <rdfs:comment>工程造价领域所有实体的顶层父类</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  二级分类：四大主题                                        -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="TechnicalTopic">
        <rdfs:subClassOf rdf:resource="CostEntity"/>
        <rdfs:comment>技术主题：公路工程技术与设计相关内容</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="ManagementTopic">
        <rdfs:subClassOf rdf:resource="CostEntity"/>
        <rdfs:comment>管理主题：组织机构与管理流程相关内容</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="EconomicTopic">
        <rdfs:subClassOf rdf:resource="CostEntity"/>
        <rdfs:comment>经济主题：造价、定额、清单、材料价格等经济数据</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="RegulatoryTopic">
        <rdfs:subClassOf rdf:resource="CostEntity"/>
        <rdfs:comment>法规主题：法律法规与标准规范</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  核心业务类                                                -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="HighwayProject">
        <rdfs:subClassOf rdf:resource="TechnicalTopic"/>
        <rdfs:comment>公路工程项目整体，包含若干分部工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="ProjectComponent">
        <rdfs:subClassOf rdf:resource="TechnicalTopic"/>
        <rdfs:comment>公路工程的分部、分项工程，是 HighwayProject 的组成部分</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Subgrade">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>路基工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Pavement">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>路面工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Bridge">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>桥梁工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Tunnel">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>隧道工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="TrafficSafetyFacility">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>交通安全设施</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Electromechanical">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>机电工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="EnvironmentalProtection">
        <rdfs:subClassOf rdf:resource="ProjectComponent"/>
        <rdfs:comment>环境保护工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="TenderBudget">
        <rdfs:subClassOf rdf:resource="EconomicTopic"/>
        <rdfs:comment>招标预算/控制价，包含多个清单子目</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Quota">
        <rdfs:subClassOf rdf:resource="EconomicTopic"/>
        <rdfs:comment>定额（含人工、材料、机械台班消耗量及基价）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="BillItem">
        <rdfs:subClassOf rdf:resource="EconomicTopic"/>
        <rdfs:comment>工程量清单子目（含子目号、名称、单位、单价）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="MaterialEquipment">
        <rdfs:subClassOf rdf:resource="EconomicTopic"/>
        <rdfs:comment>材料或设备（含名称、型号、价格）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="CostCase">
        <rdfs:subClassOf rdf:resource="EconomicTopic"/>
        <rdfs:comment>历史造价案例，用于类比分析</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="LawRegulation">
        <rdfs:subClassOf rdf:resource="RegulatoryTopic"/>
        <rdfs:comment>法律法规（具有强制性）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="StandardSpecification">
        <rdfs:subClassOf rdf:resource="RegulatoryTopic"/>
        <rdfs:comment>标准规范（含推荐性和强制性）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="Organization">
        <rdfs:subClassOf rdf:resource="ManagementTopic"/>
        <rdfs:comment>组织机构（发布单位、编制单位等）</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  对象属性（关系）                                          -->
    <!-- ========================================================= -->

    <owl:ObjectProperty rdf:about="hasComponent">
        <rdfs:label>包含分部工程</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="ProjectComponent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>HighwayProject 由多个 ProjectComponent 构成</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="isPartOf">
        <rdfs:label>是...的组成部分</rdfs:label>
        <rdfs:domain rdf:resource="ProjectComponent"/>
        <rdfs:range rdf:resource="HighwayProject"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>与 hasComponent 互逆</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="hasComponent">
        <owl:inverseOf rdf:resource="isPartOf"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="basedOn">
        <rdfs:label>依据于</rdfs:label>
        <rdfs:domain rdf:resource="TenderBudget"/>
        <rdfs:range rdf:resource="CostEntity"/>
        <rdfs:comment>预算编制所依据的定额、规范或法规</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="applyTo">
        <rdfs:label>适用于</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="BillItem"/>
        <rdfs:comment>某条定额适用于哪个清单子目</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="issuedBy">
        <rdfs:label>由...发布</rdfs:label>
        <rdfs:domain rdf:resource="StandardSpecification"/>
        <rdfs:range rdf:resource="Organization"/>
        <owl:FunctionalProperty/>
        <rdfs:comment>一份标准只能由一个机构发布</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="contains">
        <rdfs:label>包含清单子目</rdfs:label>
        <rdfs:domain rdf:resource="TenderBudget"/>
        <rdfs:range rdf:resource="BillItem"/>
        <rdfs:comment>招标预算由多个清单子目组成</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="hasMaterial">
        <rdfs:label>使用材料/设备</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="MaterialEquipment"/>
        <rdfs:comment>清单子目施工所需的主要材料或设备</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="referencesCase">
        <rdfs:label>参考案例</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="CostCase"/>
        <rdfs:comment>新建项目参考的历史造价案例</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="basedOnStandard">
        <rdfs:label>依据规范</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="StandardSpecification"/>
        <rdfs:comment>定额编制所依据的标准规范</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ========================================================= -->
    <!--  数据属性                                                  -->
    <!-- ========================================================= -->

    <owl:DatatypeProperty rdf:about="projectName">
        <rdfs:label>项目名称</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="projectType">
        <rdfs:label>项目类型</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="roadClass">
        <rdfs:label>公路等级</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="designSpeed">
        <rdfs:label>设计速度</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="routeLength">
        <rdfs:label>路线长度</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="terrainType">
        <rdfs:label>地形类型</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="location">
        <rdfs:label>项目位置</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="constructionStartDate">
        <rdfs:label>开工日期</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="constructionEndDate">
        <rdfs:label>竣工日期</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="totalInvestment">
        <rdfs:label>总造价</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="costPerKm">
        <rdfs:label>每公里造价</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="laborCostRatio">
        <rdfs:label>人工费占比</rdfs:label>
        <rdfs:domain rdf:resource="HighwayProject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="budgetAmount">
        <rdfs:label>预算金额</rdfs:label>
        <rdfs:domain rdf:resource="TenderBudget"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>预算总金额</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="budgetYear">
        <rdfs:label>预算年份</rdfs:label>
        <rdfs:domain rdf:resource="TenderBudget"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>预算编制年份</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaCode">
        <rdfs:label>定额编号</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaName">
        <rdfs:label>定额名称</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaType">
        <rdfs:label>定额类型</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaBasePrice">
        <rdfs:label>定额基价</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额基价（含人工、材料、机械费用）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaLaborPrice">
        <rdfs:label>定额人工费</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额人工费</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quotaMaterialPrice">
        <rdfs:label>定额材料费</rdfs:label>
        <rdfs:domain rdf:resource="Quota"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额材料费</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="standardCode">
        <rdfs:label>标准编号</rdfs:label>
        <rdfs:domain rdf:resource="StandardSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="standardName">
        <rdfs:label>标准名称</rdfs:label>
        <rdfs:domain rdf:resource="StandardSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="effectiveDate">
        <rdfs:label>生效日期</rdfs:label>
        <rdfs:domain rdf:resource="StandardSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="version">
        <rdfs:label>版本号</rdfs:label>
        <rdfs:domain rdf:resource="StandardSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>版本号</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="subItemCode">
        <rdfs:label>子目编号</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="subItemName">
        <rdfs:label>子目名称</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="unitOfMeasure">
        <rdfs:label>计量单位</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="unitPrice">
        <rdfs:label>单价</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="quantity">
        <rdfs:label>工程量</rdfs:label>
        <rdfs:domain rdf:resource="BillItem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>清单工程量</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="materialName">
        <rdfs:label>材料名称</rdfs:label>
        <rdfs:domain rdf:resource="MaterialEquipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="materialPrice">
        <rdfs:label>材料价格</rdfs:label>
        <rdfs:domain rdf:resource="MaterialEquipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="materialModel">
        <rdfs:label>型号规格</rdfs:label>
        <rdfs:domain rdf:resource="MaterialEquipment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>材料或设备的型号规格</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="orgName">
        <rdfs:label>机构名称</rdfs:label>
        <rdfs:domain rdf:resource="Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="orgType">
        <rdfs:label>机构类型</rdfs:label>
        <rdfs:domain rdf:resource="Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>机构类型（政府、事业单位、企业等）</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>