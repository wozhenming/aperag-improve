<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#">
  <owl:Ontology rdf:about="http://example.org/cost-ontology#">
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <rdfs:label xml:lang="zh">test</rdfs:label>
  </owl:Ontology>
  <owl:Class rdf:about="http://example.org/cost-ontology#Project">
    <rdfs:label xml:lang="zh">项目</rdfs:label>
    <rdfs:comment xml:lang="zh">建设项目</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/cost-ontology#Engineering">
    <rdfs:label xml:lang="zh">工程</rdfs:label>
    <rdfs:comment xml:lang="zh">工程项目中的具体工程</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/cost-ontology#Material">
    <rdfs:label xml:lang="zh">材料</rdfs:label>
    <rdfs:comment xml:lang="zh">工程材料</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/cost-ontology#Cost">
    <rdfs:label xml:lang="zh">费用</rdfs:label>
    <rdfs:comment xml:lang="zh">造价相关费用</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://example.org/cost-ontology#hasEngineering">
    <rdfs:domain rdf:resource="http://example.org/cost-ontology#Project"/>
    <rdfs:range rdf:resource="http://example.org/cost-ontology#Engineering"/>
    <rdfs:label xml:lang="zh">包含工程</rdfs:label>
    <rdfs:comment xml:lang="zh">项目包含多个工程</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cost-ontology#usesMaterial">
    <rdfs:domain rdf:resource="http://example.org/cost-ontology#Engineering"/>
    <rdfs:range rdf:resource="http://example.org/cost-ontology#Material"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="zh">使用材料</rdfs:label>
    <rdfs:comment xml:lang="zh">工程使用的材料</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cost-ontology#hasCost">
    <rdfs:domain rdf:resource="http://example.org/cost-ontology#Engineering"/>
    <rdfs:range rdf:resource="http://example.org/cost-ontology#Cost"/>
    <rdfs:label xml:lang="zh">产生费用</rdfs:label>
    <rdfs:comment xml:lang="zh">工程产生的费用</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/cost-ontology#materialCost">
    <rdfs:domain rdf:resource="http://example.org/cost-ontology#Material"/>
    <rdfs:range rdf:resource="http://example.org/cost-ontology#Cost"/>
    <rdfs:label xml:lang="zh">材料费用</rdfs:label>
    <rdfs:comment xml:lang="zh">材料的费用</rdfs:comment>
  </owl:ObjectProperty>
</rdf:RDF>