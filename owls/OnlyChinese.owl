<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF 
    xmlns="http://www.cost-ontology.cn/ontology#" 
    xml:base="http://www.cost-ontology.cn/ontology"
    xmlns:owl="http://www.w3.org/2002/07/owl#" 
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" 
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" 
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.cost-ontology.cn/ontology">
        <rdfs:comment>公路工程造价知识图谱本体（纯中文版 v3.0）</rdfs:comment>
        <owl:versionInfo>3.0</owl:versionInfo>
        <rdfs:seeAlso>基于 JTG/T 3832-2018 公路工程预算定额及配套编制办法</rdfs:seeAlso>
    </owl:Ontology>

    <!-- ========================================================= -->
    <!--  顶层根类                                                  -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="造价实体">
        <rdfs:comment>工程造价领域所有实体的顶层父类</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  二级分类：四大主题                                        -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="技术主题">
        <rdfs:subClassOf rdf:resource="造价实体"/>
        <rdfs:comment>技术主题：公路工程技术与设计相关内容</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="管理主题">
        <rdfs:subClassOf rdf:resource="造价实体"/>
        <rdfs:comment>管理主题：组织机构与管理流程相关内容</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="经济主题">
        <rdfs:subClassOf rdf:resource="造价实体"/>
        <rdfs:comment>经济主题：造价、定额、清单、材料价格等经济数据</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="法规主题">
        <rdfs:subClassOf rdf:resource="造价实体"/>
        <rdfs:comment>法规主题：法律法规与标准规范</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  核心业务类                                                -->
    <!-- ========================================================= -->

    <owl:Class rdf:about="公路项目">
        <rdfs:subClassOf rdf:resource="技术主题"/>
        <rdfs:comment>公路工程项目整体，包含若干分部工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="分部工程">
        <rdfs:subClassOf rdf:resource="技术主题"/>
        <rdfs:comment>公路工程的分部、分项工程，是公路项目的组成部分</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="路基工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>路基工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="路面工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>路面工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="桥梁工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>桥梁工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="隧道工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>隧道工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="交通安全设施">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>交通安全设施</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="机电工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>机电工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="环境保护工程">
        <rdfs:subClassOf rdf:resource="分部工程"/>
        <rdfs:comment>环境保护工程</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="招标预算">
        <rdfs:subClassOf rdf:resource="经济主题"/>
        <rdfs:comment>招标预算/控制价，包含多个清单子目</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="定额">
        <rdfs:subClassOf rdf:resource="经济主题"/>
        <rdfs:comment>定额（含人工、材料、机械台班消耗量及基价）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="清单子目">
        <rdfs:subClassOf rdf:resource="经济主题"/>
        <rdfs:comment>工程量清单子目（含子目号、名称、单位、单价）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="材料设备">
        <rdfs:subClassOf rdf:resource="经济主题"/>
        <rdfs:comment>材料或设备（含名称、型号、价格）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="造价案例">
        <rdfs:subClassOf rdf:resource="经济主题"/>
        <rdfs:comment>历史造价案例，用于类比分析</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="法律法规">
        <rdfs:subClassOf rdf:resource="法规主题"/>
        <rdfs:comment>法律法规（具有强制性）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="标准规范">
        <rdfs:subClassOf rdf:resource="法规主题"/>
        <rdfs:comment>标准规范（含推荐性和强制性）</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="组织机构">
        <rdfs:subClassOf rdf:resource="管理主题"/>
        <rdfs:comment>组织机构（发布单位、编制单位等）</rdfs:comment>
    </owl:Class>

    <!-- ========================================================= -->
    <!--  对象属性（关系）                                          -->
    <!-- ========================================================= -->

    <owl:ObjectProperty rdf:about="包含分部工程">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="分部工程"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>公路项目由多个分部工程构成</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="属于项目">
        <rdfs:domain rdf:resource="分部工程"/>
        <rdfs:range rdf:resource="公路项目"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment>分部工程属于某个公路项目</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="包含分部工程">
        <owl:inverseOf rdf:resource="属于项目"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="依据于">
        <rdfs:domain rdf:resource="招标预算"/>
        <rdfs:range rdf:resource="造价实体"/>
        <rdfs:comment>预算编制所依据的定额、规范或法规</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="适用于">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="清单子目"/>
        <rdfs:comment>某条定额适用于哪个清单子目</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="由发布">
        <rdfs:domain rdf:resource="标准规范"/>
        <rdfs:range rdf:resource="组织机构"/>
        <owl:FunctionalProperty/>
        <rdfs:comment>一份标准只能由一个机构发布</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="包含清单子目">
        <rdfs:domain rdf:resource="招标预算"/>
        <rdfs:range rdf:resource="清单子目"/>
        <rdfs:comment>招标预算由多个清单子目组成</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="使用材料设备">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="材料设备"/>
        <rdfs:comment>清单子目施工所需的主要材料或设备</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="参考案例">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="造价案例"/>
        <rdfs:comment>新建项目参考的历史造价案例</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="依据规范">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="标准规范"/>
        <rdfs:comment>定额编制所依据的标准规范</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ========================================================= -->
    <!--  数据属性                                                  -->
    <!-- ========================================================= -->

    <!-- ---------- 公路项目属性 ---------- -->
    <owl:DatatypeProperty rdf:about="项目名称">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="项目类型">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="公路等级">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="设计速度">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="路线长度">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="地形类型">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="项目位置">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="开工日期">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="竣工日期">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="总造价">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="每公里造价">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="人工费占比">
        <rdfs:domain rdf:resource="公路项目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- ---------- 招标预算属性 ---------- -->
    <owl:DatatypeProperty rdf:about="预算金额">
        <rdfs:domain rdf:resource="招标预算"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>预算总金额</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="预算年份">
        <rdfs:domain rdf:resource="招标预算"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>预算编制年份</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ---------- 定额属性 ---------- -->
    <owl:DatatypeProperty rdf:about="定额编号">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="定额名称">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="定额类型">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="定额基价">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额基价（含人工、材料、机械费用）</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="定额人工费">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额人工费</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="定额材料费">
        <rdfs:domain rdf:resource="定额"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>定额材料费</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ---------- 标准规范属性 ---------- -->
    <owl:DatatypeProperty rdf:about="标准编号">
        <rdfs:domain rdf:resource="标准规范"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="标准名称">
        <rdfs:domain rdf:resource="标准规范"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="生效日期">
        <rdfs:domain rdf:resource="标准规范"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="版本号">
        <rdfs:domain rdf:resource="标准规范"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>版本号</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ---------- 清单子目属性 ---------- -->
    <owl:DatatypeProperty rdf:about="子目编号">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="子目名称">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="计量单位">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="单价">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="工程量">
        <rdfs:domain rdf:resource="清单子目"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>清单工程量</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ---------- 材料设备属性 ---------- -->
    <owl:DatatypeProperty rdf:about="材料名称">
        <rdfs:domain rdf:resource="材料设备"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="材料价格">
        <rdfs:domain rdf:resource="材料设备"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="型号规格">
        <rdfs:domain rdf:resource="材料设备"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>材料或设备的型号规格</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- ---------- 组织机构属性 ---------- -->
    <owl:DatatypeProperty rdf:about="机构名称">
        <rdfs:domain rdf:resource="组织机构"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:FunctionalProperty/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="机构类型">
        <rdfs:domain rdf:resource="组织机构"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>机构类型（政府、事业单位、企业等）</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>